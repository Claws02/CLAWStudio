{
  "name": "clawengineering-studio",
  "version": "1.0.0",
  "private": true,
  "description": "CLAW Engineering video studio \u2014 data-driven, code-rendered comparison videos.",
  "type": "module",
  "scripts": {
    "content": "node scripts/build.mjs",
    "content:watch": "node scripts/build.mjs --watch",
    "new": "node scripts/new-video.mjs",
    "prestudio": "npm run content",
    "studio": "remotion studio",
    "preweb": "npm run content",
    "web": "vite",
    "prerender": "npm run content",
    "render": "node scripts/render.mjs",
    "prebuild:web": "npm run content",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run content && npm run typecheck",
    "build": "node scripts/build.mjs",
    "studio:web": "vite"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@remotion/cli": "4.0.509",
    "@remotion/fonts": "4.0.509",
    "@remotion/media-utils": "4.0.509",
    "@remotion/player": "4.0.509",
    "codemirror": "^6.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.509"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
